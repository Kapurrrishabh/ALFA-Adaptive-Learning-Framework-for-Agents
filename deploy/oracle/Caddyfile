# HTTPS for the app, with a certificate Caddy gets and renews itself; the agent is never exposed.
# The security headers come from the app, so every host serves the same ones.
{$DOMAIN} {
	# port 80 is closed on purpose, so the certificate is proved on 443 alone
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	# PROVISIONAL: above the app's own 10 MB import limit, which counts the file alone, so its plain message reaches people
	request_body {
		max_size 11MB
	}
	header -Server
	reverse_proxy app:8000
}
